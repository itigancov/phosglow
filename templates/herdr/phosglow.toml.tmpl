# Phosglow for herdr. Paste this under the [theme] section of
# ~/.config/herdr/config.toml, then run `herdr server reload-config`.
# Custom colours sit on top of the built-in theme named in [theme].
[theme.custom]
panel_bg      = "reset"      # keeps the Ghostty background and shader
sidebar_bg    = "{{sidebar}}"
active_row_bg = "{{row_active}}"
selection_bg  = "{{selection_bg}}"
surface0      = "{{black}}"
surface1      = "{{surface_1}}"
surface_dim   = "{{bg}}"
overlay0      = "{{bright_black}}"
overlay1      = "{{inactive}}"
text          = "{{fg}}"
subtext0      = "{{green}}"
accent        = "{{bright_green}}"
green         = "{{bright_green}}"
blue          = "{{bright_blue}}"
teal          = "{{cyan}}"
mauve         = "{{magenta}}"
yellow        = "{{yellow}}"
peach         = "{{bright_yellow}}"
red           = "{{red}}"
